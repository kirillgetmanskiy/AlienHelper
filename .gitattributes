# normalise line endings in the repository, Windows endings in the working tree for Windows files
* text=auto
*.cs     text eol=crlf
*.csproj text eol=crlf
*.ps1    text eol=crlf
*.iss    text eol=crlf
*.manifest text eol=crlf
*.appxmanifest text eol=crlf
*.md     text
*.txt    text

*.png binary
*.ico binary
