<Project Sdk="Microsoft.NET.Sdk">

  <!-- What a plugin builds against: reference AlienHelper.PluginApi.dll (build.ps1 puts it into <out>\sdk). The app
       shares its own copy with every plugin, so a plugin must not bring another one (see docs\plugins.md). -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AlienHelper.Plugins</RootNamespace>
    <Product>Alien Helper Plugin API</Product>
    <!-- the assembly version changes only with the API's major version, so plugins keep binding to it -->
    <Version>1.1.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

</Project>
