<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- the Windows SDK projection: Microsoft Store add-ons (StoreAddons.cs). Plugins share it and WinRT.Runtime with
         the app (PluginLoadContext), so it is the newest one a plugin may build against: 10.0.22621 -->
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyName>AlienHelper</AssemblyName>
    <Product>Alien Helper</Product>
    <AssemblyTitle>Alien Helper</AssemblyTitle>
    <RootNamespace>AlienHelper</RootNamespace>
    <Version>0.1.23</Version>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- the test channel (build.ps1 on the test branches): its own exe and identity, installed next to prod (AppId.cs) -->
  <PropertyGroup Condition="'$(Channel)' == 'test'">
    <AssemblyName>AlienHelperTest</AssemblyName>
    <Product>Alien Helper Test</Product>
    <AssemblyTitle>Alien Helper Test</AssemblyTitle>
    <DefineConstants>$(DefineConstants);TEST_CHANNEL</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- what plugins build against; bundled into the exe and shared with every plugin (Plugins.cs) -->
    <ProjectReference Include="..\AlienHelper.PluginApi\AlienHelper.PluginApi.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\app.ico" LogicalName="AlienHelper.app.ico" />
    <EmbeddedResource Include="Assets\IntelMSR.bin" LogicalName="AlienHelper.IntelMSR.bin" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="8.0.0" />
    <!-- build assets excluded: they only copy native helpers (msdia140, KernelTraceControl) this app does not use -->
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.2.8" ExcludeAssets="build;buildTransitive" />
  </ItemGroup>

</Project>
